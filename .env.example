# Imani Vision — environment variables (TEMPLATE)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` must be listed in .gitignore.
#
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# (base64url keeps them safe to paste into DATABASE_URL)

# --- Postgres ---
# You choose these. Postgres only reads them the FIRST time the data volume is created.
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=imani
# Internal connection string used by the gateway (service name `db`, internal port 5432).
DATABASE_URL=postgresql://change_me:change_me_to_a_strong_password@db:5432/imani

# --- Auth ---
JWT_SECRET=generate_a_long_random_value_do_not_reuse

# --- Gateway <-> ML service (internal auth) ---
# Shared secret the gateway sends to the ML service so ONLY the gateway can call it.
# Must match ML_SERVICE_API_KEY in api-gateway/.env.
ML_SERVICE_API_KEY=generate_a_long_random_value

# Internal URL of the ML service (service name `ml`, internal port 8000). Not public.
ML_SERVICE_URL=http://ml:8000

# --- Portal / CORS ---
# The only origin the gateway accepts browser requests from (the portal runs on 3001).
PORTAL_ORIGIN=http://localhost:3001
